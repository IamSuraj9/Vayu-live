# Cloudflare Pages response headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Storm and wind files change every few hours: always check for a newer copy (cheap, uses ETags)
/data/*
  Cache-Control: no-cache

# Built files have content hashes in their names, so they never change: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable
